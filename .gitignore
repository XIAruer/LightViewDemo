samples/
*.tif
*.tiff
*.jp2
*.img
*.vrt
*.ovr
*.aux.xml

# ------------------------------------------------------------------ annotations and outputs
annotations/
output/
train/data/
train/runs/
*.geojson
*.kml
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg

# ------------------------------------------------------------------ model weights
# Only the small sidecars (*.onnx.json, classes.json) belong in git.
models/*
!models/*.json
models/sam/
*.onnx
*.onnx.data
*.pt
*.pth
*.ckpt
*.safetensors

# ------------------------------------------------------------------ local-only docs and backups
CLAUDE.md
.backup*/
.backup2_*/
*.log
